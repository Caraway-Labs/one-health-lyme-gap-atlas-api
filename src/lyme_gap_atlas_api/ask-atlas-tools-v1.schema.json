{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Caraway-Labs/one-health-lyme-gap-atlas-api/docs/ask-atlas-tools-v1.schema.json",
  "title": "Ask Atlas v1 structured tool call",
  "oneOf": [
    {"$ref": "#/$defs/find_measures"},
    {"$ref": "#/$defs/get_observations"},
    {"$ref": "#/$defs/get_evidence_metadata"}
  ],
  "$defs": {
    "find_measures": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "page_size"],
      "properties": {
        "tool": {"const": "find_measures"},
        "indicator_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "search_text": {"type": "string", "minLength": 1, "maxLength": 120},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 20}
      },
      "oneOf": [{"required": ["indicator_id"], "not": {"required": ["search_text"]}}, {"required": ["search_text"], "not": {"required": ["indicator_id"]}}]
    },
    "get_observations": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "measure_id", "geography_type", "geography_ids"],
      "properties": {
        "tool": {"const": "get_observations"},
        "measure_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "geography_type": {"enum": ["county", "state"]},
        "geography_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 5}},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      },
      "oneOf": [{"required": ["year"], "not": {"anyOf": [{"required": ["start_date"]}, {"required": ["end_date"]}]}}, {"required": ["start_date", "end_date"], "not": {"required": ["year"]}}]
    },
    "get_evidence_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "observation_ids"],
      "properties": {
        "tool": {"const": "get_evidence_metadata"},
        "observation_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    }
  }
}
