{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carawaylabs.com/schemas/atlas-semantic-consumer-v1.schema.json",
  "title": "Atlas semantic consumer v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "evidence_tier", "indicator", "measure", "observation", "provenance", "freshness", "lineage", "release"],
  "properties": {
    "contract_version": {"const": "atlas-semantic-consumer-v1"},
    "evidence_tier": {"enum": ["SYNTHETIC_FIXTURE", "REVIEWED_CONTRACT"]},
    "indicator": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}}
    },
    "measure": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "semantic_version", "metadata_id", "metadata_revision", "metadata_revision_id", "meaning_signature", "label", "definition", "description", "type", "origin", "unit", "denominator", "allowed_value_states", "allowed_strata", "applicability", "quality_evidence", "limitations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "semantic_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "metadata_id": {"type": "string", "minLength": 1},
        "metadata_revision": {"type": "integer", "minimum": 1},
        "metadata_revision_id": {"type": "string", "minLength": 1},
        "meaning_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "label": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "description": {"$ref": "#/$defs/state"},
        "type": {"type": "string", "minLength": 1},
        "origin": {"enum": ["REPORTED", "DERIVED"]},
        "unit": {"type": "string", "minLength": 1},
        "denominator": {"type": "string", "minLength": 1},
        "allowed_value_states": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/value_state"}},
        "allowed_strata": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "applicability": {
          "type": "object", "additionalProperties": false,
          "required": ["geography_grain", "temporal_semantics", "allowed_strata", "origin", "representativeness"],
          "properties": {
            "geography_grain": {"enum": ["COUNTY", "SITE_EVENT", "SOURCE_ONLY_COUNTY"]},
            "temporal_semantics": {"enum": ["PERIOD", "POINT_IN_TIME", "CUMULATIVE_THROUGH_DATE"]},
            "allowed_strata": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "origin": {"enum": ["REPORTED", "DERIVED"]},
            "representativeness": {"type": "string", "minLength": 1}
          }
        },
        "quality_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["quality_contract", "propagation_contract", "eligibility_contract", "uncertainty", "evidence_basis"],
          "properties": {
            "quality_contract": {"$ref": "#/$defs/state"},
            "propagation_contract": {"$ref": "#/$defs/state"},
            "eligibility_contract": {"$ref": "#/$defs/state"},
            "uncertainty": {"$ref": "#/$defs/state"},
            "evidence_basis": {"$ref": "#/$defs/state"}
          }
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision_id", "value", "value_state", "geography", "temporal", "strata", "denominator_value"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "value_state": {"$ref": "#/$defs/value_state"},
        "geography": {
          "type": "object", "additionalProperties": false, "required": ["grain"],
          "properties": {
            "grain": {"enum": ["COUNTY", "SITE_EVENT", "SOURCE_ONLY_COUNTY"]},
            "county_fips": {"type": ["string", "null"], "pattern": "^[0-9]{5}$"},
            "site_id": {"type": "string", "minLength": 1},
            "event_id": {"type": "string", "minLength": 1},
            "representativeness": {"type": "string", "minLength": 1},
            "county_relationship": {"enum": ["SOURCE_REPORTED_COUNTY", "ATLAS_DERIVED_MATCH"]},
            "mapping_version": {"type": "string", "minLength": 1},
            "reported_geography_id": {"type": "string", "minLength": 1},
            "mapping_status": {"enum": ["UNMAPPED", "AMBIGUOUS"]}
          }
        },
        "temporal": {
          "type": "object", "additionalProperties": false, "required": ["semantics"],
          "properties": {
            "semantics": {"enum": ["PERIOD", "POINT_IN_TIME", "CUMULATIVE_THROUGH_DATE"]},
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"},
            "date": {"type": "string", "format": "date"}
          }
        },
        "strata": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "denominator_value": {"type": ["number", "null"]}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["publisher", "source_id", "dataset_id", "source_version_id", "source_vintage", "method_version", "transformation_version"],
      "properties": {
        "publisher": {"$ref": "#/$defs/state"},
        "source_id": {"$ref": "#/$defs/state"},
        "dataset_id": {"$ref": "#/$defs/state"},
        "source_version_id": {"$ref": "#/$defs/state"},
        "source_vintage": {"$ref": "#/$defs/state"},
        "method_version": {"$ref": "#/$defs/state"},
        "transformation_version": {"$ref": "#/$defs/state"}
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_period", "source_vintage", "retrieved_at", "published_at", "metadata_revised_at"],
      "properties": {
        "observation_period": {"$ref": "#/$defs/state"},
        "source_vintage": {"$ref": "#/$defs/state"},
        "retrieved_at": {"$ref": "#/$defs/state"},
        "published_at": {"$ref": "#/$defs/state"},
        "metadata_revised_at": {"$ref": "#/$defs/state"}
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["lineage_id", "semantic_observation_id", "semantic_revision_id", "measure_id", "measure_version", "metadata_revision_id", "publisher", "dataset_id", "source_version_id", "source_vintage", "methodology_version", "transformation_version", "limitations", "evidence_basis", "representativeness", "record_refs", "result_id", "result_revision_id", "release_id"],
      "properties": {
        "lineage_id": {"type": "string", "minLength": 1},
        "semantic_observation_id": {"type": "string", "minLength": 1},
        "semantic_revision_id": {"type": "string", "minLength": 1},
        "measure_id": {"$ref": "#/$defs/id"},
        "measure_version": {"type": "string", "minLength": 1},
        "metadata_revision_id": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "source_version_id": {"type": "string", "minLength": 1},
        "source_vintage": {"type": "string", "minLength": 1},
        "methodology_version": {"type": "string", "minLength": 1},
        "transformation_version": {"type": "string", "minLength": 1},
        "limitations": {"$ref": "#/$defs/limitations"},
        "evidence_basis": {"type": ["string", "null"]},
        "representativeness": {"type": ["string", "null"]},
        "record_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "result_id": {"type": ["string", "null"]},
        "result_revision_id": {"type": ["string", "null"]},
        "release_id": {"type": ["string", "null"]}
      }
    },
    "release": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false, "required": ["id", "bundle_sha256"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]*$"},
    "state": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": {
        "state": {"enum": ["KNOWN", "UNKNOWN", "NOT_APPLICABLE", "UNAVAILABLE"]},
        "value": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "KNOWN"}}}, "then": {"properties": {"value": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"state": {"enum": ["UNKNOWN", "NOT_APPLICABLE", "UNAVAILABLE"]}}}, "then": {"properties": {"value": {"type": "null"}}}}
      ]
    },
    "value_state": {"enum": ["OBSERVED", "ZERO", "MISSING", "UNKNOWN", "SUPPRESSED", "NOT_REPORTED", "UNAVAILABLE", "NOT_DEFENSIBLE", "NO_RECORDS", "NO_COUNTY_LINKED_RECORD"]},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["category", "code", "text"],
        "properties": {
          "category": {"enum": ["USE_RESTRICTION", "INTERPRETATION", "REPRESENTATIVENESS", "DENOMINATOR", "SOURCE", "METHOD"]},
          "code": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
