{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Caraway-Labs/one-health-lyme-gap-atlas-api/docs/ask-atlas-tools-v1.schema.json",
  "title": "Ask Atlas v1 typed tool call",
  "oneOf": [
    {"$ref": "#/$defs/find_measures"},
    {"$ref": "#/$defs/get_observations"},
    {"$ref": "#/$defs/get_evidence_metadata"}
  ],
  "$defs": {
    "county": {"type": "object", "additionalProperties": false, "required": ["geography_type", "geography_id"], "properties": {"geography_type": {"const": "county"}, "geography_id": {"type": "string", "pattern": "^[0-9]{5}$"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["geography_type", "geography_id"], "properties": {"geography_type": {"const": "state"}, "geography_id": {"type": "string", "pattern": "^[0-9]{2}$"}}},
    "evidence_reference": {"type": "object", "required": ["resource_type", "resource_id"], "additionalProperties": false, "properties": {"resource_type": {"type": "string", "minLength": 1}, "resource_id": {"type": "string", "minLength": 1}, "source_id": {"type": ["string", "null"]}, "provenance_ref": {"type": ["string", "null"]}, "semantic_version": {"type": ["string", "null"]}, "methodology_version": {"type": ["string", "null"]}, "release_id": {"type": ["string", "null"]}, "uri": {"type": ["string", "null"]}}},
    "find_measures": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "page_size"],
      "properties": {
        "tool": {"const": "find_measures"},
        "indicator_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "search_text": {"type": "string", "minLength": 1, "maxLength": 120},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 20}
      },
      "anyOf": [{"required": ["indicator_id"]}, {"required": ["search_text"]}]
    },
    "get_observations": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "measure_id", "geographies"],
      "properties": {
        "tool": {"const": "get_observations"},
        "measure_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "geographies": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"oneOf": [{"$ref": "#/$defs/county"}, {"$ref": "#/$defs/state"}]}},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      },
      "oneOf": [{"required": ["year"], "not": {"anyOf": [{"required": ["start_date"]}, {"required": ["end_date"]}]}}, {"required": ["start_date", "end_date"], "not": {"required": ["year"]}}]
    },
    "get_evidence_metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "evidence_refs"],
      "properties": {
        "tool": {"const": "get_evidence_metadata"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_reference"}}
      }
    }
  }
}
