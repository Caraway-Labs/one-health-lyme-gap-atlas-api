            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/atlas/scores": {
      "get": {
        "tags": [
          "atlas"
        ],
        "summary": "Scores",
        "operationId": "scores_v1_atlas_scores_get",
        "parameters": [
          {
            "name": "dataset_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dataset Version"
            }
          },
          {
            "name": "ecological_share",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "multipleOf": 5,
              "maximum": 85,
              "minimum": 40,
              "default": 65,
              "title": "Ecological Share"
            }
          },
          {
            "name": "low_incidence_breakpoint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 25,
              "minimum": 5,
              "default": 10,
              "title": "Low Incidence Breakpoint"
            }
          },
          {
            "name": "missing_human_weakness",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "multipleOf": 5,
              "maximum": 90,
              "minimum": 40,
              "default": 75,
              "title": "Missing Human Weakness"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreCollection"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/counties/{fips}": {
      "get": {
        "tags": [
          "counties"
        ],
        "summary": "County",
        "operationId": "county_v1_counties__fips__get",
        "parameters": [
          {
            "name": "fips",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{5}$",
              "title": "Fips"
            }
          },
          {
            "name": "dataset_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dataset Version"
            }
          },
          {
            "name": "ecological_share",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "multipleOf": 5,
              "maximum": 85,
              "minimum": 40,
              "default": 65,
              "title": "Ecological Share"
            }
          },
          {
            "name": "low_incidence_breakpoint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 25,
              "minimum": 5,
              "default": 10,
              "title": "Low Incidence Breakpoint"
            }
          },
          {
            "name": "missing_human_weakness",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "multipleOf": 5,
              "maximum": 90,
              "minimum": 40,
              "default": 75,
              "title": "Missing Human Weakness"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountyDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/atlas/ranking.csv": {
      "get": {
        "tags": [
          "atlas"
        ],
        "summary": "Ranking Csv",
        "operationId": "ranking_csv_v1_atlas_ranking_csv_get",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(ALL|[A-Z]{2})$",
              "default": "ALL",
              "title": "State"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "evidence",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "all",
                "ecological",
                "human",
                "complete"
              ],
              "type": "string",
              "default": "all",
              "title": "Evidence"
            }
          },
          {
            "name": "ecological_share",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "multipleOf": 5,
              "maximum": 85,
              "minimum": 40,
              "default": 65,
              "title": "Ecological Share"
            }
          },
          {
            "name": "low_incidence_breakpoint",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 25,
              "minimum": 5,
              "default": 10,
              "title": "Low Incidence Breakpoint"
            }
          },
          {
            "name": "missing_human_weakness",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "multipleOf": 5,
              "maximum": 90,
              "minimum": 40,
              "default": 75,
              "title": "Missing Human Weakness"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
